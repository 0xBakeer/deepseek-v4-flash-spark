+++ b/exllamav3/exllamav3_ext/arm64_stubs.cpp
@@ -0,0 +1,49 @@
+// aarch64 build shim (DGX Spark / GB10): the CPU MoE offload kernels and the tensor-parallel CPU
+// all-reduce are x86-only (AVX2/AVX-512 intrinsics). Those sources are excluded from the build on
+// aarch64 by setup.py and the entry points below keep the extension linkable. Every stub either
+// reports "not supported" or throws; nothing here runs on the single-GPU serving path.
+#if defined(__aarch64__)
+#include <ATen/Tensor.h>
+#include <c10/util/Exception.h>
+#include <cstdint>
+#include <vector>
+#include "avx2_target.h"
+#include "avx512_target.h"
+#include "cpu/moe_mul1.h"
+#include "parallel/all_reduce_cpu_avx2.h"
+#include "parallel/all_reduce_cpu_avx512.h"
+
+#define ARM_UNSUPPORTED(name) TORCH_CHECK(false, name ": x86 AVX2/AVX-512 CPU path is not available on aarch64")
+
+bool is_avx2_supported() { return false; }
+bool is_f16c_supported() { return false; }
+bool is_avx512_supported() { return false; }
+
+void enable_fast_fp() {}
+void enable_fast_fp_avx2() {}
+void enable_fast_fp_avx512() {}
+
+void perform_cpu_reduce(PGContext*, size_t, uint32_t, uint32_t, uint8_t*, size_t) { ARM_UNSUPPORTED("perform_cpu_reduce"); }
+void perform_cpu_reduce_avx2(PGContext*, size_t, uint32_t, uint32_t, uint8_t*, size_t) { ARM_UNSUPPORTED("perform_cpu_reduce_avx2"); }
+void perform_cpu_reduce_avx512(PGContext*, size_t, uint32_t, uint32_t, uint8_t*, size_t) { ARM_UNSUPPORTED("perform_cpu_reduce_avx512"); }
+void bf16_add_inplace_avx512(uint16_t*, const uint16_t*, size_t) { ARM_UNSUPPORTED("bf16_add_inplace_avx512"); }
+void bf16_add_twosrc_avx512(uint16_t*, const uint16_t*, const uint16_t*, size_t) { ARM_UNSUPPORTED("bf16_add_twosrc_avx512"); }
+void fp16_add_inplace_avx512(uint16_t*, const uint16_t*, size_t) { ARM_UNSUPPORTED("fp16_add_inplace_avx512"); }
+void fp16_add_twosrc_avx512(uint16_t*, const uint16_t*, const uint16_t*, size_t) { ARM_UNSUPPORTED("fp16_add_twosrc_avx512"); }
+void cpu_reduce_parallel(void (*)(uint16_t*, const uint16_t*, const uint16_t*, size_t), void (*)(uint16_t*, const uint16_t*, size_t),
+                         uint16_t*, const uint16_t*, const uint16_t*, size_t, int) { ARM_UNSUPPORTED("cpu_reduce_parallel"); }
+
+int64_t exl3_moe_cpu_make_layer(const std::vector<at::Tensor>&, const std::vector<at::Tensor>&, const std::vector<at::Tensor>&,
+                                const std::vector<at::Tensor>&, const std::vector<at::Tensor>&, const std::vector<at::Tensor>&,
+                                const std::vector<at::Tensor>&, const std::vector<at::Tensor>&, const std::vector<at::Tensor>&,
+                                const std::vector<at::Tensor>&, const std::vector<at::Tensor>&, const std::vector<at::Tensor>&,
+                                int64_t, double, int64_t) { ARM_UNSUPPORTED("exl3_moe_cpu_make_layer"); return -1; }
+void exl3_moe_cpu_free_layer(int64_t) {}
+void exl3_moe_cpu_forward(int64_t, const at::Tensor&, const at::Tensor&, const at::Tensor&, at::Tensor&, int64_t) { ARM_UNSUPPORTED("exl3_moe_cpu_forward"); }
+void exl3_moe_cpu_forward_raw(int64_t, const at::Half*, const int32_t*, const at::Half*, float*, int, int, int) { ARM_UNSUPPORTED("exl3_moe_cpu_forward_raw"); }
+void exl3_moe_cpu_stage_experts(int64_t, const uint32_t*, int, uint8_t*, int) { ARM_UNSUPPORTED("exl3_moe_cpu_stage_experts"); }
+void exl3_moe_cpu_set_prof(bool) {}
+bool exl3_moe_cpu_has_avx2() { return false; }
+bool exl3_moe_cpu_has_avx512_vnni() { return false; }
+bool exl3_moe_cpu_has_avx512_vbmi() { return false; }
+#endif
